flowchart LR
    Agent["Patient Agent"]
    Planner["GOAP Planner"]
    Executor["Action Executor"]
    Rollback["Emergency Rollback"]
    World["Shared World State"]
    Manager["Environment Manager"]
    Resources["Hospital Resources<br/>conditional access filters"]

    Agent -->|"goal + attributes"| Planner
    Planner -->|"plan"| Executor
    Executor -->|"attempt access"| Resources
    Resources -->|"accepted / rejected"| Executor
    Executor -->|"effects"| World
    World -->|"snapshot"| Planner
    World -->|"queue / occupancy"| Manager
    Manager -->|"world change"| World
    Manager -->|"availability rules"| Resources
    Executor -->|"invalid target"| Rollback
    Rollback -->|"release resources"| World
    Rollback -.->|"replan"| Agent
